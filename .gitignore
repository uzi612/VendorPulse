# === Python / Django (Backend) ===
# Matches the actual directory name (Backend/). Git paths are case-sensitive
# on Linux/CI, so lowercase patterns would silently stop ignoring these.
Backend/venv/
Backend/**/__pycache__/
Backend/*.pyc
Backend/db.sqlite3
Backend/media/
Backend/staticfiles/
Backend/spa/
Backend/.env

# === Node / React (Frontend) ===
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.env
frontend/.vite/

# === IDEs & Editors ===
.vscode/
.idea/
*.swp
*.swo

# === Operating System Files ===
.DS_Store
Thumbs.db

# Environment variables
.env

# === Local database dumps / exports ===
# backups/ holds prod-bound dumps (may contain password hashes and customer data)
backups/
*.sql
*.sql.gz
*.dump