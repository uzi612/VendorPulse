# /etc/cron.d/vendorpulse-backup
# Nightly database + media backups. Keep backups off the server too.
# Requires /etc/vendorpulse/backup.cnf (see backup.cnf.example).

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin

0 2 * * * root mysqldump --defaults-extra-file=/etc/vendorpulse/backup.cnf --single-transaction --routines --triggers vendorpulse | gzip > /var/backups/vendorpulse/db-$(date +\%F).sql.gz
30 2 * * * root rsync -a /var/www/vendorpulse/shared/media/ /var/backups/vendorpulse/media/
