# VendorPulse backend environment template.
# Copy to Backend/.env (git-ignored) and fill in real values.
# Never commit the real .env.

# --- Django ---------------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=vendorpulse.example.com
CSRF_TRUSTED_ORIGINS=https://vendorpulse.example.com
# Only needed when the frontend is served from a different origin.
CORS_ALLOWED_ORIGINS=

# --- Database (MySQL) -----------------------------------------------------
DB_NAME=vendorpulse
DB_USER=vp
DB_PASSWORD=replace-with-a-strong-password
DB_HOST=127.0.0.1
DB_PORT=3306

# Managed MySQL (TiDB Cloud, PlanetScale, ...) requires TLS.
# DB_SSL_MODE=REQUIRED
# DB_SSL_CA=/etc/ssl/certs/provider-ca.pem   # with DB_SSL_MODE=VERIFY_IDENTITY

# --- Cache / throttling ---------------------------------------------------
# Shared cache so DRF throttle counters work across Gunicorn workers.
REDIS_URL=redis://127.0.0.1:6379/1

# --- Media ----------------------------------------------------------------
# Persist uploads outside the release directory (shared across deploys).
# MEDIA_ROOT=/var/www/vendorpulse/shared/media

# --- Supabase Storage (Render track; optional) ----------------------------
# S3-compatible object storage. Without these, uploads stay on local disk.
# SUPABASE_BUCKET=vendorpulse-media
# SUPABASE_ENDPOINT_URL=https://<project-ref>.supabase.co/storage/v1/s3
# SUPABASE_ACCESS_KEY_ID=replace-with-s3-access-key
# SUPABASE_SECRET_ACCESS_KEY=replace-with-s3-secret-key
# SUPABASE_REGION=us-east-1
# Public URL prefix of the bucket (bucket must be public).
# SUPABASE_PUBLIC_HOST=<project-ref>.supabase.co/storage/v1/object/public/vendorpulse-media

# --- Render (optional) -----------------------------------------------------
# RENDER_EXTERNAL_HOSTNAME is injected by Render; ALLOWED_HOSTS and
# CSRF_TRUSTED_ORIGINS are extended automatically, so leave them as-is.
# 512 MB free instance: keep two workers.
# WEB_WORKERS=2
# WEB_THREADS=4
# First deploy only: create zones/hubs/routes/agents (~440 accounts).
# SEED_ON_START=1
# The API only calls /api/...; bare mounts are dev-only in production.
# SERVE_BARE_API=False
